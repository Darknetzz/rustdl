#!/bin/sh
# After a successful push of dev to github, build and refresh rustdl-dev plus any new stable release.
# Installed via: scripts/install_dev_release_hook.ps1 (sets core.hooksPath = .githooks)
#
# Git has no post-push hook; this schedules publish in the background once the remote
# ref matches the commit being pushed (see scripts/wait_and_publish_dev.*).

remote="$1"
repo_root=$(git rev-parse --show-toplevel) || exit 0
wait_script="$repo_root/scripts/wait_and_publish_dev.ps1"
wait_script_sh="$repo_root/scripts/wait_and_publish_dev.sh"
log_hint="${TMPDIR:-/tmp}/rustdl-dev-release.log"
case "$(uname -s 2>/dev/null)" in
MINGW* | MSYS* | CYGWIN* | Windows*)
	log_hint="${TEMP:-/tmp}/rustdl-dev-release.log"
	;;
esac

# Start a command in background; return 0 if it is still running or exited successfully.
start_background() {
	"$@" &
	bg_pid=$!
	sleep 0.5
	if kill -0 "$bg_pid" 2>/dev/null; then
		return 0
	fi
	wait "$bg_pid" 2>/dev/null
	return $?
}

# Returns 0 when a background publish task was scheduled, 1 otherwise.
schedule_publish() {
	commit="$1"
	echo "rustdl: scheduling dev release publish in background (log: $log_hint)" >&2
	if command -v pwsh >/dev/null 2>&1; then
		if [ ! -f "$wait_script" ]; then
			echo "rustdl: could not schedule dev release publish (missing $wait_script)" >&2
			return 1
		fi
		case "$(uname -s 2>/dev/null)" in
		MINGW* | MSYS* | CYGWIN* | Windows*)
			# Detach from the terminal: plain '&' still shares stdout with git push / pushall.
			if ! pwsh -NoProfile -ExecutionPolicy Bypass -Command "
				Start-Process -FilePath pwsh -WindowStyle Hidden -ArgumentList @(
					'-NoProfile',
					'-ExecutionPolicy', 'Bypass',
					'-File', '$wait_script',
					'-Remote', '$remote',
					'-Commit', '$commit',
					'-Quiet'
				) | Out-Null
			"; then
				echo "rustdl: could not schedule dev release publish (pwsh Start-Process failed)" >&2
				return 1
			fi
			;;
		*)
			if ! start_background pwsh -NoProfile -ExecutionPolicy Bypass -File "$wait_script" -Remote "$remote" -Commit "$commit" -Quiet; then
				echo "rustdl: could not schedule dev release publish (pwsh failed to start)" >&2
				return 1
			fi
			;;
		esac
	elif command -v powershell >/dev/null 2>&1; then
		if [ ! -f "$wait_script" ]; then
			echo "rustdl: could not schedule dev release publish (missing $wait_script)" >&2
			return 1
		fi
		case "$(uname -s 2>/dev/null)" in
		MINGW* | MSYS* | CYGWIN* | Windows*)
			if ! powershell -NoProfile -ExecutionPolicy Bypass -Command "
				Start-Process -FilePath powershell -WindowStyle Hidden -ArgumentList @(
					'-NoProfile',
					'-ExecutionPolicy', 'Bypass',
					'-File', '$wait_script',
					'-Remote', '$remote',
					'-Commit', '$commit',
					'-Quiet'
				) | Out-Null
			"; then
				echo "rustdl: could not schedule dev release publish (powershell Start-Process failed)" >&2
				return 1
			fi
			;;
		*)
			if ! start_background powershell -NoProfile -ExecutionPolicy Bypass -File "$wait_script" -Remote "$remote" -Commit "$commit" -Quiet; then
				echo "rustdl: could not schedule dev release publish (powershell failed to start)" >&2
				return 1
			fi
			;;
		esac
	elif [ -x "$wait_script_sh" ]; then
		if ! start_background "$wait_script_sh" "$remote" "$commit"; then
			echo "rustdl: could not schedule dev release publish ($wait_script_sh failed to start)" >&2
			return 1
		fi
	else
		echo "rustdl: could not schedule dev release publish (no pwsh/powershell/wait script)" >&2
		return 1
	fi
	return 0
}

publish_failed=0

# pre-push stdin: <local ref> SP <local sha> SP <remote ref> SP <remote sha> LF
while read -r local_ref local_sha remote_ref remote_sha; do
	[ "$remote" = "github" ] || continue
	[ "$remote_ref" = "refs/heads/dev" ] || continue
	# branch delete
	[ "$local_sha" = "0000000000000000000000000000000000000000" ] && continue
	if ! schedule_publish "$local_sha"; then
		publish_failed=1
	fi
done

if [ "$publish_failed" -ne 0 ]; then
	echo "rustdl: push aborted — dev/stable release publish was not scheduled." >&2
	echo "rustdl: install pwsh or powershell, or ensure scripts/wait_and_publish_dev.* exists." >&2
	echo "rustdl: or push with --no-verify after fixing, or run scripts/push_dev.ps1 manually." >&2
	exit 1
fi

exit 0
