#!/bin/sh
# After a successful push of dev to github, build and refresh rustdl-dev plus any new stable release.
# Installed via: scripts/install_dev_release_hook.ps1 (sets core.hooksPath = .githooks)
#
# Git has no post-push hook; this schedules publish in the background once the remote
# ref matches the commit being pushed (see scripts/wait_and_publish_dev.*).

remote="$1"
repo_root=$(git rev-parse --show-toplevel) || exit 0
wait_script="$repo_root/scripts/wait_and_publish_dev.ps1"
log_hint="${TMPDIR:-/tmp}/rustdl-dev-release.log"
case "$(uname -s 2>/dev/null)" in
MINGW* | MSYS* | CYGWIN* | Windows*)
	log_hint="${TEMP:-/tmp}/rustdl-dev-release.log"
	;;
esac

schedule_publish() {
	commit="$1"
	echo "rustdl: scheduling dev release publish in background (log: $log_hint)" >&2
	if command -v pwsh >/dev/null 2>&1; then
		case "$(uname -s 2>/dev/null)" in
		MINGW* | MSYS* | CYGWIN* | Windows*)
			# Detach from the terminal: plain '&' still shares stdout with git push / pushall.
			pwsh -NoProfile -ExecutionPolicy Bypass -Command "
				Start-Process -FilePath pwsh -WindowStyle Hidden -ArgumentList @(
					'-NoProfile',
					'-ExecutionPolicy', 'Bypass',
					'-File', '$wait_script',
					'-Remote', '$remote',
					'-Commit', '$commit',
					'-Quiet'
				) | Out-Null
			"
			;;
		*)
			pwsh -NoProfile -ExecutionPolicy Bypass -File "$wait_script" -Remote "$remote" -Commit "$commit" -Quiet &
			;;
		esac
	elif command -v powershell >/dev/null 2>&1; then
		powershell -NoProfile -ExecutionPolicy Bypass -Command "
			Start-Process -FilePath powershell -WindowStyle Hidden -ArgumentList @(
				'-NoProfile',
				'-ExecutionPolicy', 'Bypass',
				'-File', '$wait_script',
				'-Remote', '$remote',
				'-Commit', '$commit',
				'-Quiet'
			) | Out-Null
		"
	elif [ -x "$repo_root/scripts/wait_and_publish_dev.sh" ]; then
		"$repo_root/scripts/wait_and_publish_dev.sh" "$remote" "$commit" &
	else
		echo "rustdl: could not schedule dev release publish (no pwsh/powershell/wait script)" >&2
	fi
}

# pre-push stdin: <local ref> SP <local sha> SP <remote ref> SP <remote sha> LF
while read -r local_ref local_sha remote_ref remote_sha; do
	[ "$remote" = "github" ] || continue
	[ "$remote_ref" = "refs/heads/dev" ] || continue
	# branch delete
	[ "$local_sha" = "0000000000000000000000000000000000000000" ] && continue
	schedule_publish "$local_sha"
done

exit 0
