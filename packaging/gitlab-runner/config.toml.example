# Example GitLab Runner config for rustdl (Linux host, Docker executor).
# Copy to /etc/gitlab-runner/config.toml on the runner machine.
# Do not commit real runner tokens.
#
# Windows native builds use a separate shell/pwsh runner — see
# config.toml.windows.example (tag `windows`, run untagged jobs OFF).
#
# Register first:
#   gitlab-runner register --url https://gitlab.roste.org --token GLRT-... --executor docker --docker-image rust:latest
#
# Then merge the volumes below so crates.io downloads persist on the host.

concurrent = 2
check_interval = 0

[[runners]]
  name = "rust-builder"
  url = "https://gitlab.roste.org/"
  token = "GLRT-YOUR_RUNNER_TOKEN"
  executor = "docker"
  [runners.docker]
    tls_verify = false
    image = "rust:latest"
    privileged = false
    disable_entrypoint_overwrite = false
    oom_kill_disable = false
    disable_cache = false
    volumes = [
      "/cache",
      "/var/cache/gitlab-runner/cargo:/usr/local/cargo/registry:rw"
    ]
    shm_size = 0
